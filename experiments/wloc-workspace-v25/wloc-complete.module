#!name=WLOC Local Workspace v2.5 - Typed Location
#!desc=Isolated location candidate: unchanged v2.4 control page plus typed ARPC response adapter. Disable other WLOC modules. No new MITM hosts. Real-device location effect remains unverified.

[Script]
WLOC Bodyless Write = type=http-request,pattern=^https:\/\/wloc-settings\.invalid\/wloc-write\/v1\/(?:save|clear|restore)$,requires-body=0,max-size=0,timeout=10,script-path=https://raw.githubusercontent.com/JarynXu/wloc/2df9e824ded1b82847cda368ac726aaff97a2510/experiments/wloc-workspace-v25/dist/wloc-control.js,enable=true,argument=enabled=true&allowMissingOrigin=true
WLOC Read Only Snapshot = type=http-request,pattern=^https:\/\/wloc-settings\.invalid\/wloc-read\/v1\/$,requires-body=0,max-size=0,timeout=10,script-path=https://raw.githubusercontent.com/JarynXu/wloc/2df9e824ded1b82847cda368ac726aaff97a2510/experiments/wloc-workspace-v25/dist/wloc-control.js,enable=true,argument=enabled=true&allowMissingOrigin=true
WLOC Retired Settings = type=http-request,pattern=^https?:\/\/gs-loc(-cn)?\.apple\.com\/wloc-settings\/save(?:\?.*)?$,requires-body=0,max-size=0,timeout=5,script-path=https://raw.githubusercontent.com/JarynXu/wloc/2df9e824ded1b82847cda368ac726aaff97a2510/experiments/wloc-workspace-v25/dist/wloc-control.js,enable=true,argument=enabled=true&allowMissingOrigin=true
WLOC Local Control v2 = type=http-request,pattern=^https:\/\/wloc-settings\.invalid\/wloc-control\/v2\/,requires-body=1,max-size=4096,timeout=10,script-path=https://raw.githubusercontent.com/JarynXu/wloc/2df9e824ded1b82847cda368ac726aaff97a2510/experiments/wloc-workspace-v25/dist/wloc-control.js,enable=true,argument=enabled=true&allowMissingOrigin=true
WLOC Typed Location Response = type=http-response,pattern=^https:\/\/gs-loc(?:-cn)?\.apple\.com\/clls\/wloc(?:\?.*)?$,requires-body=1,binary-body-mode=1,max-size=2097152,timeout=30,script-path=https://raw.githubusercontent.com/JarynXu/wloc/2df9e824ded1b82847cda368ac726aaff97a2510/experiments/wloc-workspace-v25/dist/wloc-location.js,enable=true

[Rule]
DOMAIN,wloc-settings.invalid,REJECT

[MITM]
hostname = %APPEND% wloc-settings.invalid, gs-loc.apple.com, gs-loc-cn.apple.com

# Both scripts are pinned to the verified candidate commit. Control page intentionally shows v2.4.
# Do not enable together with old WLOC or diagnostic modules. Do not remove REJECT.
